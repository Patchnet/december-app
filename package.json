{
  "name": "december",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "A local-first page that organizes itself",
  "author": "Patchnet AI",
  "main": "electron/main.mjs",
  "scripts": {
    "app": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ai.patchnet.december",
    "productName": "December",
    "asar": true,
    "asarUnpack": [
      "server.mjs",
      "mcp-server.mjs",
      "lib/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "server.mjs",
      "mcp-server.mjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true
    }
  }
}
